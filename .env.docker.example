APP_NAME="Kosher Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kosher_market
DB_USERNAME=kosher_market
DB_PASSWORD=kosher_market_local

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@kosher.market"
MAIL_FROM_NAME="${APP_NAME}"

# SHKeeper Bitcoin payment gateway
BITCOIN_CURRENCY=BTC
SHKEEPER_URL=
SHKEEPER_API_KEY=
SHKEEPER_USERNAME=
SHKEEPER_PASSWORD=
SHKEEPER_FIAT=USD
SHKEEPER_CALLBACK_URL=https://your-market-domain.example/bitcoin/shkeeper/webhook
SHKEEPER_WEBHOOK_TOLERANCE_SECONDS=300
SHKEEPER_BTC_PAYOUT_FEE=5
BITCOIN_REQUIRED_CONFIRMATIONS=1
BITCOIN_PLATFORM_FEE_PERCENT=3.00
ESCROW_PLATFORM_FEE_PERCENT=3.00
ESCROW_HOLD_DAYS=3

# Manual operation: escrow release and payouts are never scheduled.
ESCROW_AUTO_RELEASE=false
BITCOIN_AUTO_PAYOUTS=false

# Vendor onboarding
KOSHER_MARKET_ADMIN_BTC_ADDRESS=

VITE_APP_NAME="${APP_NAME}"
APP_LOCALE=en
