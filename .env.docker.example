APP_NAME="Kosher Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose service names — do not use 127.0.0.1 for MySQL/Redis here.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kosher_market
DB_USERNAME=kosher_market
DB_PASSWORD=kosher_market_local

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@kosher.market"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Bitcoin / BTCPay Server
BITCOIN_CURRENCY=BTC
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BITCOIN_REQUIRED_CONFIRMATIONS=1
BITCOIN_PLATFORM_FEE_PERCENT=3.00
ESCROW_PLATFORM_FEE_PERCENT=3.00
ESCROW_HOLD_DAYS=3
ESCROW_AUTO_RELEASE=true

# Vendor onboarding
VENDOR_REGISTRATION_FEE_USD=200.00
BTCPAY_INVOICE_CURRENCY=USD
KOSHER_MARKET_ADMIN_BTC_ADDRESS=

VITE_APP_NAME="${APP_NAME}"
APP_LOCALE=en
