APP_NAME="Kosher Market"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://market.example
APP_ALLOWED_HOSTS=market.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kosher_market
DB_USERNAME=kosher_market
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SHKEEPER_URL=https://your-shkeeper-domain
SHKEEPER_API_KEY=CHANGE_ME
SHKEEPER_USERNAME=CHANGE_ME
SHKEEPER_PASSWORD=CHANGE_ME
SHKEEPER_FIAT=USD
SHKEEPER_CALLBACK_URL=https://market.example/monero/shkeeper/webhook
SHKEEPER_WEBHOOK_TOLERANCE_SECONDS=300
SHKEEPER_XMR_PAYOUT_PRIORITY=2
MONERO_REQUIRED_CONFIRMATIONS=1
XMR_PLATFORM_FEE_PERCENT=3.00
ESCROW_HOLD_DAYS=3
ESCROW_AUTO_RELEASE=false
VENDOR_REGISTRATION_FEE_USD=200.00
