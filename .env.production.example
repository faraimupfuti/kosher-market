APP_NAME="Kosher Market"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kosher.market

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kosher_market
DB_USERNAME=kosher_market
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

BROADCAST_DRIVER=log
CACHE_STORE=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@kosher.market"
MAIL_FROM_NAME="${APP_NAME}"

# Bitcoin / BTCPay. Store secrets only in the deployment environment.
BITCOIN_CURRENCY=BTC
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_INVOICE_CURRENCY=BTC
BITCOIN_REQUIRED_CONFIRMATIONS=1
BITCOIN_AUTO_PAYOUTS=true
KOSHER_MARKET_ADMIN_BTC_ADDRESS=

# Escrow safety defaults. Keep automatic release disabled until the full
# production payment/dispute/recovery runbook has been tested.
BITCOIN_PLATFORM_FEE_PERCENT=3.00
ESCROW_PLATFORM_FEE_PERCENT=3.00
ESCROW_HOLD_DAYS=3
ESCROW_AUTO_RELEASE=false
VENDOR_REGISTRATION_FEE_USD=200.00

# Optional external logging/monitoring integrations.
LOG_SLACK_WEBHOOK_URL=
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
APP_LOCALE=en
